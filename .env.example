# ==============================================================================
# GaskenLE - Template Konfigurasi Environment (.env)
# ==============================================================================
# CARA PAKAI:
# 1. Salin berkas ini: cp .env.example .env
# 2. Sesuaikan konfigurasi dan isi API key Anda di .env secara manual
# 3. File .env bersifat PRIVAT dan otomatis diabaikan oleh Git.
# ==============================================================================

# --- MODE PELUNCURAN PANE 0 ---
# Pilihan:
# - "unified" : Otomatis jalankan 9router Gateway & hubungkan Hermes Agent
# - "menu"    : Tampilkan menu pemilih interaktif (Rekomendasi)
# - "hermes"  : Fokus hanya ke Hermes Agent Docker
# - "9router" : Fokus hanya ke 9router Gateway
# - "shell"   : Shell Bash biasa
AGENT_MODE="menu"

# --- INTEGRASI HERMES AGENT (DOCKER) ---
# Nama container Docker untuk Hermes
HERMES_CONTAINER_NAME="gasken-hermes"
# Port Hermes Gateway (Host:Container)
HERMES_PORT=6666
# Direktori proyek Hermes (biarkan kosong untuk menggunakan ./hermes bawaan repo ini)
HERMES_DIR=""

# Model default yang diminta Hermes ke 9router
HERMES_MODEL="hermes-3-llama-3.1-8b"

# --- INTEGRASI 9ROUTER GATEWAY ---
# Port server 9router (default: 20128)
NINEROUTER_PORT=20128
NINEROUTER_HOST="0.0.0.0"
# Endpoint 9router yang dihubungi oleh Hermes dari dalam Docker
NINEROUTER_GATEWAY_URL="http://host.docker.internal:20128/v1"

# Path ke direktori 9router kustom jika ingin memakai instalasi yang sudah ada
# (Contoh: /home/hikaruu/9router-agentic-AI, atau kosongkan untuk memakai template internal ./9router)
CUSTOM_NINEROUTER_DIR=""

# --- API KEYS & CREDENTIALS (DIISI MANUAL OLEH PENGGUNA) ---
# Kunci API ini dapat diteruskan ke 9router / Hermes sesuai kebutuhan
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
